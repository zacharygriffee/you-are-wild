{
  "schemaVersion": 1,
  "mapId": "you-are-wild-local-work",
  "targetAdapterHint": "node-js",
  "profile": {
    "safeCommands": [
      "npm run build",
      "npm run test",
      "npm run audit:branding"
    ],
    "isolateTargetRepo": true,
    "providerAllowed": true,
    "allowedActions": [
      "local-file-write",
      "local-command",
      "local-test",
      "docs-generation",
      "provider-call"
    ],
    "operatorMediatedActions": [
      "push",
      "publish",
      "public-network",
      "package-install",
      "proof-promotion",
      "repo-complete-acceptance",
      "product-direction",
      "explicit-content-expansion"
    ],
    "forbiddenActions": [
      "credential-use",
      "raw-secrets",
      "destructive-host-command"
    ]
  },
  "operatorBoundaries": [
    {
      "id": "controls-final-direction",
      "title": "Final control doctrine decisions",
      "boundary": "product-direction",
      "reason": "Agents may propose and document controls, but final traversal, selection, and intent-control decisions belong to the operator."
    },
    {
      "id": "adult-content-expansion",
      "title": "Adult content expansion",
      "boundary": "explicit-content-expansion",
      "reason": "This lane map is for controls, UI, map metadata, and architecture. Agents must not expand explicit content."
    },
    {
      "id": "canonical-release-action",
      "title": "Canonical release action",
      "boundary": "release",
      "reason": "Pushing, publishing, release packaging, and final branding/legal decisions remain operator-mediated."
    }
  ],
  "lanes": [
    {
      "laneId": "controls-doctrine",
      "priority": 10,
      "title": "Controls Doctrine",
      "objective": "Create a UI-safe control model for traversal, actor selection, target selection, intent selection, and inspection surfaces before more autonomous UI changes.",
      "statusBasis": {
        "mode": "terminal-checks",
        "terminalChecks": [
          {
            "checkType": "content",
            "file": "docs/control-model.md",
            "containsAll": [
              "Traversal mode",
              "Selection mode",
              "Intent mode",
              "Inspection mode"
            ]
          },
          {
            "checkType": "content",
            "file": "docs/next-objectives.md",
            "containsAll": [
              "control model"
            ]
          }
        ]
      },
      "workOrder": {
        "likelyFiles": [
          "docs/control-model.md",
          "docs/next-objectives.md"
        ],
        "expectedChangedFiles": [
          "docs/control-model.md",
          "docs/next-objectives.md"
        ],
        "requiredCommands": [
          "npm run test",
          "npm run audit:branding"
        ],
        "acceptanceCriteria": [
          "Control model document defines traversal selection intent and inspection modes.",
          "Next objectives reference the control model.",
          "npm run test exits 0",
          "npm run audit:branding exits 0"
        ],
        "criteriaChecks": [
          {
            "criterion": "Control model document defines traversal selection intent and inspection modes.",
            "checkType": "content",
            "file": "docs/control-model.md",
            "containsAll": [
              "Traversal mode",
              "Selection mode",
              "Intent mode",
              "Inspection mode"
            ]
          },
          {
            "criterion": "Next objectives reference the control model.",
            "checkType": "content",
            "file": "docs/next-objectives.md",
            "containsAll": [
              "control model"
            ]
          },
          {
            "criterion": "npm run test exits 0",
            "checkType": "command-exit",
            "command": "npm run test"
          },
          {
            "criterion": "npm run audit:branding exits 0",
            "checkType": "command-exit",
            "command": "npm run audit:branding"
          }
        ],
        "forbiddenPaths": [
          "dist/you-are-wild.html",
          "app/src/core/app.js",
          "app/template.html",
          "app/test/test.js",
          "package-lock.json"
        ],
        "nonClaims": [
          "Does not implement the controls.",
          "Does not make final product-direction decisions.",
          "Does not expand or review explicit content."
        ]
      }
    },
