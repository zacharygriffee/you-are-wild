{
  "schemaVersion": 1,
  "mapId": "you-are-wild-implementation-lanes",
  "targetAdapterHint": "node-js",
  "profile": {
    "safeCommands": [
      "npm run check",
      "npm run test",
      "npm run lint",
      "npm run audit:branding"
    ],
    "isolateTargetRepo": true,
    "providerAllowed": true,
    "allowedActions": [
      "local-file-write",
      "local-command",
      "local-test",
      "docs-generation",
      "provider-call"
    ],
    "operatorMediatedActions": [
      "push",
      "publish",
      "public-network",
      "package-install",
      "proof-promotion",
      "repo-complete-acceptance",
      "product-direction",
      "explicit-content-expansion",
      "legal-claim"
    ],
    "forbiddenActions": [
      "credential-use",
      "raw-secrets",
      "destructive-host-command",
      "adult-content-expansion",
      "dist-hand-edit"
    ]
  },
  "operatorBoundaries": [
    {
      "id": "explicit-content-boundary",
      "title": "No explicit content expansion",
      "boundary": "explicit-content-expansion",
      "reason": "Lane work is limited to mechanics, UI, map metadata, safe labels, and architecture. Agents must not expand, rewrite, or generate explicit content."
    },
    {
      "id": "legal-and-branding-claims",
      "title": "No legal claims",
      "boundary": "legal-claim",
      "reason": "Agents may implement metadata and naming cleanup, but must not claim legal safety or licensing conclusions."
    },
    {
      "id": "release-and-publish",
      "title": "Release actions stay manual",
      "boundary": "release",
      "reason": "Pushing, publishing, public network actions, proof promotion, and final repo acceptance remain operator-mediated."
    }
  ],
  "lanes": [
    {
      "laneId": "interaction-eligibility-enforcement",
      "priority": 10,
      "title": "Interaction Eligibility Enforcement",
      "objective": "Enforce the sapient/person-like default creature canon in baseline interaction eligibility without expanding explicit content or breaking stable species IDs.",
      "statusBasis": {
        "mode": "terminal-checks",
        "terminalChecks": [
          {
            "checkType": "content",
            "file": "app/src/core/app.js",
            "containsAll": [
              "DEFAULT_SPECIES_CANON",
              "sapience",
              "bodyPlan",
              "baselineInteraction"
            ]
          },
          {
            "checkType": "command-exit",
            "command": "npm run check"
          }
        ]
      },
      "workOrder": {
        "likelyFiles": [
          "app/src/core/app.js",
          "app/src/core/content-system.js",
          "app/test/test.js",
          "docs/creature-canon.md",
          "docs/next-objectives.md"
        ],
        "expectedChangedFiles": [
          "app/src/core/app.js",
          "app/test/test.js",
          "dist/you-are-wild.html"
        ],
        "requiredCommands": [
          "npm run build",
          "npm run test",
          "npm run lint",
          "npm run check"
        ],
        "acceptanceCriteria": [
          "Canon metadata exists for default species.",
          "Interaction eligibility tests or helpers use canon metadata.",
          "Build command passes.",
          "Test command passes.",
          "Lint command passes.",
          "Check command passes."
        ],
        "criteriaChecks": [
          {
            "criterion": "Canon metadata exists for default species.",
            "checkType": "content",
            "file": "app/src/core/app.js",
            "containsAll": [
              "DEFAULT_SPECIES_CANON",
              "speciesTraits",
              "baselineInteraction"
            ]
          },
          {
            "criterion": "Interaction eligibility tests or helpers use canon metadata.",
            "checkType": "content",
            "file": "app/test/test.js",
            "containsAny": [
              "baselineInteraction",
              "species canon",
              "sapience"
            ]
          },
          {
            "criterion": "Build command passes.",
            "checkType": "command-exit",
            "command": "npm run build"
          },
          {
            "criterion": "Test command passes.",
            "checkType": "command-exit",
            "command": "npm run test"
          },
          {
            "criterion": "Lint command passes.",
            "checkType": "command-exit",
            "command": "npm run lint"
          },
          {
            "criterion": "Check command passes.",
            "checkType": "command-exit",
            "command": "npm run check"
          }
        ],
        "forbiddenPaths": [
          "package-lock.json"
        ],
        "nonClaims": [
          "Does not provide legal advice.",
          "Does not expand explicit content.",
          "Does not rename stable species IDs unless tests and compatibility are updated."
        ]
      }
    },
