{
  "name": "fightfuckfeed-tactical",
  "version": "0.10.0",
  "private": true,
  "description": "Tactical dark-mode edition of FightFuckFeed.me - single-file HTML game with modular source",
  "scripts": {
    "build": "node build.js",
    "check": "node build.js --check",
    "test": "node test/test.js",
    "test:core": "node test/test.js --filter=core",
    "test:ui": "node test/test.js --filter=ui",
    "lint": "node build.js --lint-only",
    "watch": "node build.js --watch",
    "dev": "node dev.js",
    "clean": "rm -f ../dist/FightFuckFeed.tactical.html",
    "full-build": "npm run clean && npm run build && npm run test && npm run lint && npm run check"
  },
  "keywords": ["game", "tactical", "rpg", "browser"],
  "license": "MIT",
  "devDependencies": {
    "serve": "^14.2.0"
  }
}
