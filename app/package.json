{
  "name": "you-are-wild",
  "version": "0.14.0",
  "private": true,
  "description": "Creature-focused exploration RPG built as a single-file HTML game with modular source",
  "scripts": {
    "build": "node build.js",
    "build:hosted": "node build.js --hosted",
    "check": "node build.js --check",
    "test": "node test/test.js",
    "test:core": "node test/test.js --filter=core",
    "test:ui": "node test/test.js --filter=ui",
    "test:viewport": "node test/viewport-check.js",
    "test:interactions": "node test/combat-interactions-check.js",
    "lint": "node build.js --lint-only",
    "watch": "node build.js --watch",
    "dev": "node dev.js",
    "clean": "rm -f ../dist/you-are-wild.html",
    "full-build": "npm run clean && npm run build && npm run test && npm run lint && npm run check && npm run test:viewport && npm run test:interactions"
  },
  "keywords": [
    "game",
    "tactical",
    "rpg",
    "browser"
  ],
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.61.1",
    "serve": "^14.2.0"
  }
}
